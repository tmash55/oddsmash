{
  "functions": {
    "app/api/**": {
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/mispriced-odds",
      "schedule": "*/15 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://unjuiced.bet/$1",
      "permanent": true
    }
  ]
}
